{
  "name": "sprinter",
  "version": "1.0.0",
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client --lan",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "export:ios": "expo export --platform ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile development",
    "qr": "node scripts/qr.cjs",
    "lint": "eslint App.tsx src",
    "format": "prettier --write App.tsx src/navigation src/screens src/ui src/analysis/SeriesChart.tsx src/settings/TrackingPanel.tsx src/spotify/TrackSheet.tsx src/spotify/components.tsx"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.24",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.12",
    "expo-auth-session": "~58.0.18",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.4",
    "expo-location": "~58.0.21",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "expo-widgets": "~58.0.26",
    "fast-xml-parser": "^5.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "$react",
    "react-native": "$react-native"
  }
}
