{
  "expo": {
    "name": "Sprinter",
    "slug": "sprinter-pace",
    "version": "1.0.0",
    "scheme": [
      "sprinter",
      "app.sprinter.running"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.sprinter.running",
      "usesAppleSignIn": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "spotify"
        ],
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.sprinter.running",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101011"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sprinter utilise votre position précise pour enregistrer vos courses et mesurer votre allure.",
          "locationAlwaysAndWhenInUsePermission": "Pendant une course démarrée par vous, Sprinter enregistre le trajet même écran verrouillé. Le suivi s’arrête en pause manuelle et en fin de course. En pause automatique, la position permet de détecter la reprise.",
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysPermission": "Sprinter utilise votre position pendant les courses que vous démarrez, y compris écran verrouillé si vous activez ce suivi.",
          "locationFullAccuracyPermission": "La position précise permet à Sprinter de mesurer votre allure et la distance de votre course."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "backgroundColor": "#101011"
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "./plugins/with-sprinter-apple",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.sprinter.running.ExpoWidgetsTarget",
          "groupIdentifier": "group.app.sprinter.running",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.sprinter.running.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.sprinter.running"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "429ba0a6-7672-4e65-b1b0-d0f311820e23"
      }
    }
  }
}
